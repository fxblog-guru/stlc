{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "@playwright/test"]
  },
  "include": ["scripts/**/*.ts", "playwright.config.ts"],
  "exclude": ["scripts/unit/**", "scripts/mobile/**", "scripts/performance/**", "scripts/**/__screenshots__/**", "node_modules", "runs"]
}
