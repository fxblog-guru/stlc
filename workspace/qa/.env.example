# Copy to .env.<env> (e.g. .env.uat) and fill in. Never commit filled-in files.

# --- Application under test ---
BASE_URL=
API_BASE_URL=
TEST_USER=
TEST_PASSWORD=
# OpenAPI document used by scripts/shared/schemas/openapi.validator.ts (path relative to <qa-root>/, or URL)
OPENAPI_SPEC=docs/openapi.yaml
# The app's test-id attribute (<qa-root>/docs/element-registry.md declares the same value)
TEST_ID_ATTRIBUTE=data-testid

# --- Auth (scripts/shared/config/env.ts + auth/session.ts) — PROJECT SETUP: pick the mode your API uses ---
# none          no auth at all (public API)
# session-csrf  POST AUTH_LOGIN_PATH → session cookie + a CSRF token (at AUTH_CSRF_PATH in the body)
#               sent in AUTH_CSRF_HEADER on every non-GET
# bearer-login  POST AUTH_LOGIN_PATH → token at AUTH_TOKEN_PATH (dot path in the JSON body)
# basic         HTTP Basic with the actor's user/password
# header        static token from API_TOKEN sent as `Authorization: Bearer <API_TOKEN>`
# The `setup` project signs every actor in ONCE per run over the API and writes .auth/<env>/.
AUTH_MODE=bearer-login
AUTH_LOGIN_PATH=/auth/login
# JSON field names of the sign-in body
AUTH_USER_FIELD=username
AUTH_PASSWORD_FIELD=password
AUTH_TOKEN_PATH=access_token
# session-csrf only
# AUTH_CSRF_PATH=csrf_token
# AUTH_CSRF_HEADER=X-CSRF-Token
# dot path of the signed-in account's id in the sign-in body (lets factories grant per-project roles)
# AUTH_ID_PATH=me.id
# parallel sign-ins in the setup project (default 8); 1 when sign-in is rate limited per IP — 429s are
# waited out by Retry-After, so keep the pool as small as the worker count needs
# AUTH_SIGN_IN_CONCURRENCY=8
# API_TOKEN=

# --- Actors -------------------------------------------------------------------------------------
# Named actors have GLOBAL privileges and are shared by all workers (read through them, create data
# you own, never change the account itself): TEST_USER (= `default`) and TEST_USER_<NAME>/TEST_PASSWORD_<NAME>.
# TEST_USER_OWNER=
# TEST_PASSWORD_OWNER=
#
# The account pool gives every worker its OWN plain accounts (a disjoint slice per worker), so
# tests that grant roles, change settings or lock accounts never collide. Templates take {n} or
# {n:3} (zero-padded). Seed at least workers × TEST_POOL_PER_WORKER accounts; setup checks it.
# TEST_POOL_USER=user.{n:3}@example.test
# TEST_POOL_PASSWORD=password-{n:3}
# TEST_POOL_SIZE=0
# TEST_POOL_PER_WORKER=4

# --- Run identity ---------------------------------------------------------------------------------
# Every entity a test creates carries qa-<QA_RUN_ID>-w<worker>-… so runs never collide and the
# sweeper can remove leftovers. executing-tests sets it; CI uses the pipeline id.
# QA_RUN_ID=local
# QA_KEEP_ON_FAIL=1   keep a failed test's data for debugging

# --- Platforms & browsers (PROJECT-PROFILE §Platforms, CONTRACTS §20) ---
# platforms the Playwright run covers: web · api · windows · macos (Electron); android/ios run on Maestro (below) or in the mobile repo
PW_PLATFORMS=web,api
# web targets → projects web-<target>: chromium,firefox,webkit,mobile-chrome,mobile-safari (or web-chromium,…, desktop-electron)
PW_PROJECTS=chromium
# ELECTRON_APP_PATH=<path to the desktop build's executable>   desktop-electron project; unset → desktop specs skip with that reason
# ELECTRON_APP_ARGS=<launch args, e.g. main.js>
# --- UI testing (PROJECT-PROFILE §UI testing) ---
# UI_MAX_DIFF_PIXEL_RATIO=0.01   share of pixels a screenshot may differ by
# UI_VIEWPORTS=320,768,1280      web widths the ui specs' VIEWPORTS export lists
# PW_CHANNEL=msedge   run the chromium project on the installed Edge/Chrome instead of the downloaded build
# PW_WORKERS=4

# --- Mobile on Maestro (§Platforms Runner `maestro`, scripts/shared/maestro/README.md) ---
# The runner passes only these to a flow, as -e variables; credentials are TEST_USER / TEST_PASSWORD
# above (+ TEST_USER_<ROLE> / TEST_PASSWORD_<ROLE> per extra actor). Values are never printed.
# MOBILE_ANDROID_APP_ID=com.example.app          the build under test, installed on the device
# MOBILE_IOS_APP_ID=com.example.app
# MOBILE_API_TOKEN=<bearer token for data setup and cleanup through API_BASE_URL>
# QA_T_APP_LAUNCH=20000   QA_T_SCREEN=10000   QA_T_NETWORK=15000   QA_T_TOAST=5000   (ms, read by run-context.js)

# --- Integration tier (DB assertions; read-only, parameterised — scripts/shared/db/db.client.ts) ---
# postgres://user:pass@host:5432/db · mssql://user:pass@host:1433/db · mysql://user:pass@host:3306/db
DB_CONNECTION=

# --- Performance (k6) ---
PERF_TARGET_URL=
PERF_VUS=10
PERF_DURATION=5m

# --- Security (ZAP baseline; only environments authorized in PROJECT-PROFILE §Environments) ---
ZAP_TARGET_URL=

# --- Mobile (Appium/WebdriverIO framework repo — PROJECT-PROFILE §Mobile testing) -------------
# The framework repo keeps its OWN .env (device farm keys, app passwords). Only the knobs /qa-run
# passes per run live here; leave empty to use the framework's defaults.
# MOBILE_TEST_ENV=uat
# MOBILE_DEVICES=            # comma list from the framework's config/devices/*.devices.json
# MOBILE_MATRIX=             # full = every matrix device (nightly)
# MOBILE_MAX_INSTANCES=1
# MOBILE_ANDROID_APP=        # local path or farm id of the build under test
# MOBILE_IOS_APP=

# --- Bug hunting: server log watch, fuzzing, model tests ---
# The serverWatch fixture fails a test on server log lines written while it ran. Set ONE source:
# QA_SERVER_LOG=/var/log/app/api.log                         # a file the app appends to
# QA_SERVER_LOG_CMD=docker logs --since {since} api           # or a command; {since} = test start (ISO)
# QA_SERVER_LOG_FAIL=panic|fatal|level=ERROR|"level":"error"|Traceback|Unhandled   # (default)
# QA_SERVER_LOG_GRACE_MS=100                                  # wait for the server to flush after a test
# Every API call sends a traceparent; a failure's http-log keeps its trace id and the X-Request-Id
# the server echoed, and qa:triage prints them. QA_TRACE_URL turns a trace id into a link
# ({trace_id}; Grafana Tempo, Datadog, Jaeger …). QA_TRACEPARENT=off stops sending the header.
# QA_TRACEPARENT=on
# QA_TRACE_URL=https://grafana.example/explore?left={"queries":[{"query":"{trace_id}"}]}
# QA_TRACE_URL=https://app.datadoghq.com/apm/trace/{trace_id}
# Schema fuzzing (TC-API-FUZZ-*): seed (number | random — printed on failure) and inputs per operation per actor
# QA_FUZZ_SEED=1
# QA_FUZZ_MAX=60
# Model tests (## Model cases): seed, sequences per test, steps per sequence
# QA_MODEL_SEED=1
# QA_MODEL_RUNS=5
# QA_MODEL_STEPS=15

# --- Accessibility (axe-core via Playwright) ---
# comma list of axe impacts that FAIL a case (the rest are reported as findings)
A11Y_FAIL_ON=critical,serious

# --- Test management (optional, /qa-publish and /qa-defect push) ---
# Azure DevOps
ADO_BASE_URL=
TMS_ADO_PAT=
# ADO_PROJECT=
# ADO_AREA_ROOT=
# PLAN_ID=
# SUITE_ID=
# Jira (REST scripts; the Atlassian MCP path needs none of these)
# JIRA_BASE_URL=https://<site>.atlassian.net
# JIRA_EMAIL=
# TMS_JIRA_TOKEN=
# JIRA_PROJECT_KEY=
# JIRA_CASE_ISSUE_TYPE=Test
# JIRA_BUG_ISSUE_TYPE=Bug

# --- Global-role actors (security authz specs) -------------------------------------------------
# Roles that are properties of the ACCOUNT (Owner, system admin, read-only auditor) are named
# actors: TEST_USER_<ROLE> / TEST_PASSWORD_<ROLE>. Roles granted per object (project member,
# viewer) are DATA a factory grants to a pool account — not shared logins. In CI a declared
# actor that cannot sign in fails the setup project; it never silently skips its cells.
# TEST_USER_ADMIN=
# TEST_PASSWORD_ADMIN=

# --- Report hub: verdict (PROJECT-PROFILE §Test management) --------------------
# Where runs accumulate so flakiness scores, trends and server-side gates exist.
# Leaving VERDICT_URL unset is a supported state: /qa-upload prints the command and
# reports the skip. Uploading is reporting -- it never fails a run.
# VERDICT_URL=https://verdict.example
# VERDICT_PROJECT=<project key, lowercase-kebab, created in the verdict UI>
# VERDICT_API_KEY=            # a key with results:write; in CI use a masked variable
