{
  "name": "qa-platform",
  "private": true,
  "description": "agentic-fx-qa test platform 2014 runner entry points used by /qa-run, /qa-heal, /qa-report (names are a contract: executing-tests calls them verbatim)",
  "scripts": {
    "test:e2e": "playwright test scripts/e2e",
    "test:api": "playwright test scripts/api",
    "test:integration": "playwright test scripts/integration",
    "test:perf": "bash scripts/performance/run-k6.sh",
    "test:security": "bash scripts/security/zap-baseline.sh && playwright test scripts/security --pass-with-no-tests",
    "test:unit": "bash scripts/unit/run-unit.sh",
    "test:a11y": "playwright test scripts/accessibility --pass-with-no-tests",
    "test:ui": "playwright test scripts/ui --pass-with-no-tests",
    "test:ui:update": "playwright test scripts/ui --update-snapshots=changed --pass-with-no-tests",
    "test:mobile": "bash scripts/mobile/run-mobile.sh",
    "test:mobile:maestro": "node scripts/mobile/run-maestro.mjs",
    "test:data": "node scripts/data/run-data.mjs",
    "test:smoke": "playwright test scripts/e2e scripts/api scripts/integration scripts/accessibility scripts/ui --grep @smoke --grep-invert @quarantined --pass-with-no-tests",
    "test:regression": "playwright test scripts/e2e scripts/api scripts/integration scripts/accessibility scripts/ui --grep @regression --grep-invert @quarantined --pass-with-no-tests",
    "test:quarantined": "playwright test scripts/e2e scripts/api scripts/integration scripts/security scripts/accessibility scripts/ui --grep @quarantined --pass-with-no-tests",
    "report:allure": "allure generate allure-results --clean -o allure-report && allure open allure-report",
    "typecheck": "tsc --noEmit",
    "lint": "eslint scripts playwright.config.ts --max-warnings 0",
    "heal:check": "tsc --noEmit && eslint scripts playwright.config.ts --max-warnings 0",
    "qa:lint": "node scripts/shared/lint-qa.mjs",
    "qa:score": "node scripts/shared/case-score.mjs",
    "qa:coverage": "node scripts/shared/coverage-map.mjs",
    "qa:import": "node scripts/shared/import-suite.mjs",
    "qa:heal-guard": "node scripts/shared/heal-guard.mjs",
    "qa:flaky": "node scripts/shared/flaky.mjs",
    "qa:perf": "node scripts/shared/perf-compare.mjs",
    "qa:triage": "node scripts/shared/triage.mjs",
    "qa:target": "node scripts/shared/target.mjs",
    "qa:delta": "node scripts/shared/delta.mjs",
    "qa:redact": "node scripts/shared/lib/redact.mjs",
    "qa:bench": "node scripts/shared/bench.mjs",
    "qa:learn": "node scripts/shared/learnings.mjs",
    "qa:size": "node scripts/shared/sizing.mjs",
    "qa:setup": "node scripts/shared/setup-check.mjs",
    "qa:plan:list": "node scripts/shared/run-plan.mjs list",
    "qa:plan:resolve": "node scripts/shared/run-plan.mjs resolve",
    "qa:plan:run": "node scripts/shared/run-plan.mjs run",
    "qa:plan:standard": "node scripts/shared/run-plan.mjs standard",
    "verdict:upload": "node scripts/shared/verdict-upload.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@eslint/js": "^9.0.0",
    "@playwright/test": "1.64.0",
    "@types/node": "^22.0.0",
    "ajv": "^8.17.0",
    "ajv-formats": "^3.0.1",
    "dotenv": "^16.4.0",
    "eslint": "^9.0.0",
    "eslint-plugin-playwright": "^2.0.0",
    "playwright-core": "1.64.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "yaml": "^2.5.0"
  }
}
